# No .env is needed for SQLite on http://localhost:4780.
# Change the local port only if 4780 is already in use.
# TOKENPET_PORT=4880
# HTTPS only: copy compose.https.yaml to compose.override.yaml, then set a domain/IP.
# Do not include https://, a path, or an API key.
# TOKENPET_ADDRESS=pets.example.com

# Leave empty for SQLite in the /data volume. Choose ONE existing database:
# TOKENPET_DATABASE_URL=postgres://tokenpet:URL_ENCODED_PASSWORD@db.example.com:5432/existing_db?sslmode=verify-full
# TOKENPET_DATABASE_URL=mariadb://tokenpet:URL_ENCODED_PASSWORD@db.example.com:3306/existing_db?ssl=true
TOKENPET_DATABASE_URL=
# Or mount a Docker secret and set its path (do not also set TOKENPET_DATABASE_URL).
TOKENPET_DATABASE_URL_FILE=

# PostgreSQL schema / MariaDB table prefix (tokenpet_player, tokenpet_pets, ...).
TOKENPET_DB_NAMESPACE=tokenpet
# Limits apply to EACH application container; reserve room for other DB clients.
TOKENPET_DB_POOL_MAX=30
# Default minimum is 5 (or the maximum, if lower).
TOKENPET_DB_POOL_MIN=
TOKENPET_DB_CONNECT_TIMEOUT_MS=10000
TOKENPET_DB_IDLE_TIMEOUT_MS=30000
